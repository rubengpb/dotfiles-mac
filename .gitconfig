[core]
	editor = nvim

[url "git@github.com:rubengpb/"]
  insteadOf = "gh:"

[merge]
	tool = nvimdiff
	conflictstyle = diff3
[push]
	autoSetupRemote = true

# Identity: AURA everywhere (kept out of this repo); personal only in the dotfiles repo.
# Later includes win, so the personal one goes last.
[include]
  path = ~/AURA/.gitconfig
[includeIf "gitdir:~/dotfiles/"]
  path = ~/.config/git/personal.gitconfig

[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[credential "https://github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
